# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database Credentials (from https://cloud.qdrant.io)
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-url.cloud.qdrant.io
QDRANT_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=company_policy

# Optional: Default is gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash

